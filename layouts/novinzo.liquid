<!doctype html>
{%- comment -%}
  The html element is painted and light too: rubber-band scrolling shows the canvas past the
  page, and a dark-mode browser would paint it dark.
{%- endcomment %}
<html lang="en" class="scheme-light bg-[#fafafa]">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ store.name }}">
    <title>{{ store.name }}</title>
    {%- comment -%}
      The tab icon, as in layouts/default.liquid. Inline, not a snippet: this layout serves the
      error and checkout pages, which render no snippet of their own.
    {%- endcomment %}
    {%- if store.logoImageUrl %}
    <link rel="icon" href="{{ store.logoImageUrl | image_url: width: 64 }}">
    {%- else %}
    <link rel="icon" type="image/svg+xml" href="{{ 'store-icon.svg' | asset_url }}">
    {%- endif %}
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    {{ content_for_head }}
  </head>
  <body class="antialiased">
    <main id="main-content" class="flex min-h-dvh w-full flex-col py-5 lg:py-8 px-5 lg:px-8" role="main">
      {{ content_for_layout }}
    </main>
    {{ content_for_scripts }}
  </body>
</html>
