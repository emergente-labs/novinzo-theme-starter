<!doctype html>
{%- comment -%}
  The html element is painted and light too: rubber-band scrolling shows the canvas past the
  page, and a dark-mode browser would paint it dark.
{%- endcomment %}
<html lang="en" class="scheme-light bg-[#fafafa]">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ store.name }}">
    <title>{{ store.name }}</title>
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    {{ content_for_head }}
  </head>
  <body class="antialiased">
    <main id="main-content" class="flex min-h-dvh w-full flex-col py-5 lg:py-8 px-5 lg:px-8" role="main">
      {{ content_for_layout }}
    </main>
    {{ content_for_scripts }}
  </body>
</html>
