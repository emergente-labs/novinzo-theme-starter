<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ store.name }}">
    <title>{{ store.name }}</title>
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    <style>
      /* The canvas, not just the page: rubber-band scrolling paints past the document, and
         with no `color-scheme` a dark-mode UA paints that overscroll strip with its own
         dark default. */
      html {
        color-scheme: light;
        background-color: #fafafa;
      }
      body {
        min-height: 100vh;
        background-color: #fafafa;
      }
      /* Owns the full-screen box so the page fills the viewport exactly: `border-box`
         keeps this element's own padding inside the 100vh rather than adding to it,
         which is what used to make every short page scroll by the padding. */
      .blank-shell {
        width: 100%;
        min-height: 100vh;
        min-height: 100dvh;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
      }
    </style>
    {{ content_for_head }}
  </head>
  <body class="antialiased">
    <main id="main-content" class="blank-shell py-5 lg:py-8 px-5 lg:px-8" role="main">
      {{ content_for_layout }}
    </main>
    {{ content_for_scripts }}
  </body>
</html>
