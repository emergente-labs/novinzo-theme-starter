{%- comment -%}
  Error page for 5xx and anything else that cannot render its own page. The card lives in
  the <error-page> component, not here, so every store shows the same failure page. A checkout
  return sets a tone and an action on the error, and a failed payment offers the store's support
  address.
{%- endcomment -%}
{% layout 'novinzo' %}

<error-page
  store-name="{{ store.name }}"
  store-logo-url="{% if store.logoImageUrl %}{{ store.logoImageUrl | image_url: width: 64 }}{% endif %}"
  error-title="{{ error.title }}"
  message="{{ error.message }}"
  error-code="{{ error.code }}"
  {% if error.tone %}tone="{{ error.tone }}"{% endif %}
  {% if error.action %}action-label="{{ error.action.label }}" action-href="{{ error.action.href }}"{% endif %}
  {% if store.supportEmail %}support-email="{{ store.supportEmail }}"{% endif %}
  data-island="error-page"
  data-hydrate="eager"
></error-page>
