{
  "name": "Starter Theme",
  "description": "A clean, minimal starter theme for Novinzo storefronts. Perfect for customization.",
  "author": "Novinzo",
  "tags": ["minimal", "starter", "clean"],
  "version": "1.5.6",
  "changelog": "The order page offers Connect Discord when the store has the Discord app",
  "status": "published",
  "extends": "starter@1.5.6",
  "settings": [
    {
      "id": "accent_color",
      "type": "color",
      "label": "Accent colour",
      "default": "#d4f264"
    },
    {
      "id": "hero_heading",
      "type": "text",
      "label": "Heading",
      "group": "Home page",
      "default": ""
    },
    {
      "id": "hero_text",
      "type": "textarea",
      "label": "Text under the heading",
      "group": "Home page",
      "default": "Browse our full catalog."
    },
    {
      "id": "show_customer_count",
      "type": "boolean",
      "label": "Show the customer count",
      "group": "Home page",
      "default": true
    },
    {
      "id": "show_category_filter",
      "type": "boolean",
      "label": "Show the category filter",
      "group": "Home page",
      "default": true
    }
  ]
}
