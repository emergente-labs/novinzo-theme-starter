{%- comment -%}
  Product card. Caller passes `product: product`, and `hidden: true` for a card
  that is not shown, so its image loads lazily and leaves the page's eager
  image slots to the cards on screen. The image's `sizes` follows the home grid:
  one column below 580px, two below 900px, three above, and the container stops
  growing at 1536px.
  Fields: name, urlSlug, description, firstImageUrl, lowestVariantPrice (from StorefrontProductList).
{%- endcomment -%}
<a
  href="/products/{{ product.urlSlug }}"
  class="flex shadow-lg flex-col h-full cursor-pointer bg-card/70 rounded-3xl overflow-hidden transition duration-200 hover:-translate-y-0.5"
>
  <div class="flex items-start justify-between gap-3 px-5 pt-5 pb-4">
    <div class="flex-1 min-w-0">
      <h3 class="text-sm font-semibold text-white/90 truncate">{{ product.name }}</h3>
      {% if product.lowestVariantPrice %}
        <p class="text-xs text-white/50">
          Starting from
          <span class="text-price text-base font-semibold font-mono">
            {{- product.lowestVariantPrice | money -}}
          </span>
        </p>
      {% endif %}
      <div class="w-full h-0.5 rounded-full my-4 bg-white/50 mask-r-from-50%"></div>
      {% if product.description %}
        <p class="text-xs text-white/50 leading-normal line-clamp-2">{{ product.description | markdown | strip_html | truncate: 80 }}</p>
      {% endif %}
    </div>
  </div>
  <div class="mx-3 mb-3 rounded-2xl overflow-hidden shadow-lg bg-well aspect-[4/3] shrink-0">
    {% if product.firstImageUrl %}
      {{ product.firstImageUrl | image_tag: alt: product.name, class: 'size-full object-cover', widths: '320, 480, 600, 900, 1200', sizes: '(min-width: 1536px) 410px, (min-width: 900px) 30vw, (min-width: 580px) 45vw, 100vw', lazy: hidden }}
    {% else %}
      {% render 'product-placeholder' %}
    {% endif %}
  </div>
</a>
