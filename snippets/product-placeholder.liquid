{%- comment -%}
  Fills a product image box when the product has no image, so a card or gallery keeps its
  shape instead of showing a blank panel. `currentColor` lets each caller set the tone.
{%- endcomment -%}
<div class="size-full flex items-center justify-center bg-well text-white/20">
  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
    <rect x="3" y="3" width="18" height="18" rx="4" stroke="currentColor" stroke-width="1.5"/>
    <circle cx="9" cy="9" r="1.75" stroke="currentColor" stroke-width="1.5"/>
    <path
      d="M4 16.5 8 13a2 2 0 0 1 2.6 0l3.4 3M13.5 15l1.7-1.5a2 2 0 0 1 2.6 0L20 15"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</div>
